         if shape:
             obj.Shape = shape
 
+    @staticmethod
+    def points_collinear(points):
+        """True, if all points lie on one straight line (lastni popravek)"""
+        if len(points) < 2:
+            return False
+        eps = 1e-4  # mm; koordinate v sestavih so reda 1000 mm
+        start, end = points[0], points[-1]
+        axis = end - start
+        if axis.Length < eps:
+            return False
+        axis.normalize()
+        for p in points[1:-1]:
+            d = p - start
+            if (d - axis * d.dot(axis)).Length > eps:
+                return False
+            if d.dot(axis) < -eps or d.dot(axis) > (end - start).Length + eps:
+                return False
+        return True
+
